# GoalIQ Pro (web/pro, Streamlit v1 — referenssi, tuotanto on web/pro-spa).
# KOPIOI .env:ksi lokaalisti TAI lisaa hostin secret-dashboardiin.
# ALA KOSKAAN committaa oikeita arvoja. Oikeat id:t ovat privaatissa
# goaliq-app-repossa (cos-reports/private-config/).

# --- Supabase (sama projekti kuin mobiili) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>
# Service-avain: subscription-upsert (palvelin + webhook). Palvelin-only.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# --- Stripe (ALOITA test-modella sk_test_...) ---
STRIPE_SECRET_KEY=sk_test_...
# Molemmat hinnat ovat recurring-subscriptioneita (kuukausi + vuosi).
STRIPE_PRICE_SEASON_ID=price_...
STRIPE_PRICE_MONTHLY_ID=price_...
# Webhook-secret backendin /api/webhook/stripe-web-endpointille (hostin env,
# ei tanne): STRIPE_WEB_WEBHOOK_SECRET=whsec_...

# --- Appi ---
# Checkout-redirectien base-URL (lokaali test: http://localhost:8501)
APP_BASE_URL=http://localhost:8501
